...@aws
direction: right

internet: Internet {class: res; icon: icons/Res_Internet_48_Light.svg}

region: Region {
  class: region

  vpc: VPC {
    class: vpc

    alb: "Application\nLoad Balancer\ntarget_type = ip" {class: res; icon: icons/Res_Elastic-Load-Balancing_Application-Load-Balancer_48.svg}

    az_a: az-a {
      class: az
      subnet_a: subnet_a {
        class: public-subnet
        ci: "Container instance" {
          class: instance-contents
          t1: "task (web)\nawsvpc ENI" {class: res; icon: icons/Res_Amazon-Elastic-Container-Service_Task_48.svg}
          t2: "task (web)\nawsvpc ENI" {class: res; icon: icons/Res_Amazon-Elastic-Container-Service_Task_48.svg}
        }
      }
    }

    az_b: az-b {
      class: az
      subnet_b: subnet_b {
        class: public-subnet
        ci: "Container instance" {
          class: instance-contents
          t1: "task (web)\nawsvpc ENI" {class: res; icon: icons/Res_Amazon-Elastic-Container-Service_Task_48.svg}
        }
      }
    }
  }

  gw: "Spinifex gateway\n:9999 control plane" {class: res; icon: icons/Res_Server_48_Light.svg}
  ecr: "Registry / ECR" {class: res; icon: icons/Arch_Amazon-Elastic-Container-Registry_48.svg}
}

internet -> region.vpc.alb: {class: flow}
region.vpc.alb -> region.vpc.az_a.subnet_a.ci.t1: {class: flow}
region.vpc.alb -> region.vpc.az_a.subnet_a.ci.t2: {class: flow}
region.vpc.alb -> region.vpc.az_b.subnet_b.ci.t1: {class: flow}
region.vpc.az_a.subnet_a.ci -> region.gw: "agent registers" {class: quiet}
region.vpc.az_b.subnet_b.ci -> region.gw: "agent registers" {class: quiet}
region.vpc.az_a.subnet_a.ci -> region.ecr: "image pull" {class: quiet}
region.vpc.az_b.subnet_b.ci -> region.ecr: "image pull" {class: quiet}
