...@aws
direction: right

internet: Internet {class: res; icon: icons/Res_Internet_48_Light.svg}

region: Region {
  class: region

  vpc: "VPC 10.20.0.0/16 · nginx-alb-vpc" {
    class: vpc

    igw: "Internet gateway\nnginx-alb-igw" {class: res; icon: icons/Res_Amazon-VPC_Internet-Gateway_48.svg}
    alb: "ALB nginx-alb\nlistener HTTP :80" {class: res; icon: icons/Res_Elastic-Load-Balancing_Application-Load-Balancer_48.svg}

    az: Availability Zone {
      class: az

      public_a: "public_a 10.20.1.0/24" {
        class: public-subnet
        web1: "nginx-alb-1\non node1" {class: res; icon: icons/Res_Amazon-EC2_Instance_48.svg}
        web3: "nginx-alb-3\non node3" {class: res; icon: icons/Res_Amazon-EC2_Instance_48.svg}
      }
      public_b: "public_b 10.20.2.0/24" {
        class: public-subnet
        web2: "nginx-alb-2\non node2" {class: res; icon: icons/Res_Amazon-EC2_Instance_48.svg}
      }
    }
  }
}

internet -> region.vpc.igw: "HTTP :80" {class: flow}
region.vpc.igw -> region.vpc.alb: {class: flow}
region.vpc.alb -> region.vpc.az.public_a.web1: {class: flow}
region.vpc.alb -> region.vpc.az.public_a.web3: {class: flow}
region.vpc.alb -> region.vpc.az.public_b.web2: {class: flow}
