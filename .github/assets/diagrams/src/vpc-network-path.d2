...@style
direction: down

wan: "Internet\nphysical network (WAN)" {class: internet}

host: "Host bridges" {
  class: group
  br-wan: "br-wan · Linux bridge · WAN uplink" {class: box}
  br-ext: "br-ext · OVS bridge\nbridge mapping external:br-ext" {class: box}
  br-wan -> br-ext: "veth pair" {class: flow}
}

vpc: "VPC = OVN logical router" {
  class: vpc

  extsw: "External switch\nOVN logical switch · localnet port" {class: box}
  router: "VPC router\ngateway port: public IP" {
    class: box
    width: 190
    height: 100
  }
  tables: "NAT rules\nSNAT: VPC CIDR → gateway IP\ndnat_and_snat: public ↔ private\n\nRoutes\n0.0.0.0/0 → WAN gateway" {class: box}

  subnet-a: "subnet-a (public)\n10.0.1.0/24" {
    class: public-subnet
    eni-1: "ENI\neni-1" {class: eni}
    eni-2: "ENI\neni-2" {class: eni}
  }
  subnet-b: "subnet-b (private)\n10.0.2.0/24" {
    class: private-subnet
    eni-3: "ENI\neni-3" {class: eni}
    eni-4: "ENI\neni-4" {class: eni}
  }

  extsw -> router: {class: flow}
  router -- tables: {class: quiet}
  router -> subnet-a: {class: flow}
  router -> subnet-b: {class: flow}
}

wan -> host.br-wan: {class: flow}
host.br-ext -> vpc.extsw: "localnet" {class: flow}

