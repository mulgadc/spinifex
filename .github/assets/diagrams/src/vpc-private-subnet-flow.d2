...@aws
direction: right

vpc: "VPC" {
  class: vpc
  subnet: "Private subnet" {
    class: private-subnet
    instance: "Instance\n10.0.2.5" {class: res; icon: icons/Res_Amazon-EC2_Instance_48.svg}
  }
  router: "VPC router\nlookup 0.0.0.0/0" {class: res; icon: icons/Res_Amazon-VPC_Router_48.svg}
  subnet.instance -> router: "egress packet" {class: flow}
}

dropped: "Dropped\nno default route\nno IGW attached" {class: deny}
vpc.router -> dropped: {class: flow}
