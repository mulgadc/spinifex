#!/bin/bash
set -euo pipefail

# base postinst — sets the exec bit ExtraTrees= could not for the two
# EC2-guest helpers every image carries.

# 0644 in git, and ExtraTrees= preserves source mode: without this the units die
# with EACCES on a booted guest and nowhere earlier.
chmod 0755 /usr/local/sbin/mulga-ebs-byid /usr/local/sbin/mulga-mgmt-net

# The udev rule needs no enabling; the coldplug pass at boot does.
#
# Both are meant to start on every image rather than gated on profile
# composition, because neither question is answerable at build time: any image
# may later be attached a volume, and any image may later be launched as a
# control plane. mulga-ebs-byid is udev-driven and inert until a volume
# appears; mulga-mgmt-net reads a per-launch fw_cfg blob only system VMs get
# and exits 0 when it is absent.
#
# Whether either starts at boot is declared in 10-mulga-base.preset, not here:
# mkosi runs preset-all after every postinst, resetting each unit to policy and
# discarding whatever a postinst enabled or disabled.

# openssh-server's postinst runs ssh-keygen during package install, baking an
# identical host key pair into every image. sshd-keygen.service
# (ConditionFirstBoot=yes, Before=ssh.service) regenerates them on first boot.
rm -f /etc/ssh/ssh_host_*

echo "[base] postinst complete: mulga-ebs-byid and mulga-mgmt-net start-at-boot left to preset policy, baked SSH host keys removed"
