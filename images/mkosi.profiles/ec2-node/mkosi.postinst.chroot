#!/bin/bash
set -euo pipefail

# ec2-node postinst — sets the exec bit ExtraTrees= could not, and enables the
# EBS by-id service.

# 0644 in git, and ExtraTrees= preserves source mode: without this the units die
# with EACCES on a booted guest and nowhere earlier.
chmod 0755 /usr/local/sbin/mulga-ebs-byid /usr/local/sbin/mulga-mgmt-net

# The udev rule needs no enabling; the coldplug pass at boot does.
#
# mulga-mgmt-net is enabled on every image, not just the dual-NIC ones: it reads
# its configuration from a per-launch fw_cfg blob that only system VMs get, and
# exits 0 when the blob is absent. Deciding at build time which images might one
# day be launched as a control plane is the failure this avoids.
systemctl enable mulga-ebs-byid mulga-mgmt-net

echo "[ec2-node] postinst complete: mulga-ebs-byid and mulga-mgmt-net enabled"
