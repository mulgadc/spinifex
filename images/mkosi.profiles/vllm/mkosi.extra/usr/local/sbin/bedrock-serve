#!/bin/sh
# bedrock-serve — wrapper for bedrock-serve@.service, one instance per bundle
# member. Waits for its own member's cloud-init handoff, resolves and mounts
# its own cloned weights volume read-only, then execs the member's engine
# (vLLM or TEI) against it. A standalone model is the one-member case of this
# same shape: it gets one instance, on vllmServePort, exactly as before.
#
# Handoff contract, written by the Bedrock launcher (buildBundleUserData) as
# a cloud-init write_files entry per member, so it does not exist before
# cloud-init runs:
#
#   /etc/conf.d/bedrock-bundle/<instance>.env   0600  KEY=value shell fragment:
#       BEDROCK_GROUP_ID=<bundle group id, informational>
#       BEDROCK_ENGINE=<vllm|tei>
#       BEDROCK_MODEL_ID=<Bedrock model id>
#       BEDROCK_ARGS=<extra engine flags, space-separated>
#       BEDROCK_WEIGHTS_DEVICE=<device the launcher attached this member's
#                                volume at: /dev/sdf, /dev/sdg, ...>
#       BEDROCK_SERVE_PORT=<listen port: 8000 for the vllm member, 8001+ for
#                            every tei member>
#
# ExecStart in bedrock-serve@.service passes only the systemd instance
# specifier %i (this script's $1) and contains no $VAR -- this script sources
# the handoff itself, in a shell it owns, rather than letting systemd expand
# anything from an Exec*= line.
set -eu

INSTANCE="${1:?bedrock-serve: missing instance name (pass via bedrock-serve@<instance>.service)}"

ENV_DIR="${BEDROCK_ENV_DIR:-/etc/conf.d/bedrock-bundle}"
ENV_FILE="${BEDROCK_ENV_FILE:-${ENV_DIR}/${INSTANCE}.env}"
# The unit starts before cloud-init has necessarily delivered the handoff, so
# this bounds that race rather than assuming it is already there.
ENV_WAIT_SECS="${BEDROCK_ENV_WAIT:-60}"

# Per-instance: a bundle attaches one weights volume per member, and each
# member's engine must only ever see its own, never a sibling's.
WEIGHTS_MOUNT="${BEDROCK_WEIGHTS_MOUNT:-/var/lib/bedrock/${INSTANCE}/weights}"

VLLM_VENV_BIN="${BEDROCK_VLLM_VENV_BIN:-/opt/vllm/venv/bin}"
TEI_BIN="${BEDROCK_TEI_BIN:-/opt/tei/bin/text-embeddings-router}"
TEI_LIB_DIR="${BEDROCK_TEI_LIB_DIR:-/opt/tei/cuda-lib64}"

# AttachVolume runs after the launch already returned the instance, so the
# weights volume legitimately does not exist yet when this unit first starts.
DEVICE_WAIT_SECS="${BEDROCK_DEVICE_WAIT:-120}"

SYS_BLOCK="${BEDROCK_SYS_BLOCK:-/sys/block}"
DEV_DIR="${BEDROCK_DEV_DIR:-/dev}"
BYID_DIR="${BEDROCK_BYID_DIR:-/dev/disk/by-id}"
MOUNTS_FILE="${BEDROCK_MOUNTS_FILE:-/proc/mounts}"

log() { echo "[bedrock-serve:${INSTANCE}] $*"; }
fail() { echo "[bedrock-serve:${INSTANCE}] ERROR: $*" >&2; exit 1; }

# Tries to read a *usable* handoff once: sets BEDROCK_ENGINE/BEDROCK_MODEL_ID/
# BEDROCK_ARGS/BEDROCK_WEIGHTS_DEVICE/BEDROCK_SERVE_PORT in the caller's shell
# (deliberately not run inside a `$(...)` -- a subshell's assignments do not
# survive it) and returns 0 on success. Returns 1 when the handoff is not
# there yet or is still mid-write (worth retrying -- cloud-init's write_files
# is not atomic from this reader's point of view: the file can exist, created
# but empty or half-flushed, for a brief window before its content lands),
# and 2 when a key IS present but malformed (never becomes valid by waiting
# longer, so not worth retrying).
try_load_env() {
    [ -f "${ENV_FILE}" ] || return 1

    # BEDROCK_ARGS holds a space-separated list of flags, so this cannot be a
    # plain `. "${ENV_FILE}"`: shell would parse "BEDROCK_ARGS=--foo --bar" as
    # an assignment followed by a second command and fail on the second word.
    # `read` with IFS='=' splits only the key off the front; the last
    # variable absorbs the rest of the line verbatim, spaces and all, with no
    # further word-splitting.
    _raw_group="" _raw_engine="" _raw_model="" _raw_args="" _raw_device="" _raw_port=""
    while IFS='=' read -r _key _value || [ -n "${_key:-}" ]; do
        case "${_key:-}" in
            BEDROCK_GROUP_ID)       _raw_group="${_value:-}" ;;
            BEDROCK_ENGINE)         _raw_engine="${_value:-}" ;;
            BEDROCK_MODEL_ID)       _raw_model="${_value:-}" ;;
            BEDROCK_ARGS)           _raw_args="${_value:-}" ;;
            BEDROCK_WEIGHTS_DEVICE) _raw_device="${_value:-}" ;;
            BEDROCK_SERVE_PORT)     _raw_port="${_value:-}" ;;
        esac
    done < "${ENV_FILE}"

    # Missing required keys means the write is still in flight, not that the
    # handoff is broken -- retry rather than fail.
    [ -n "${_raw_engine}" ] || return 1
    [ -n "${_raw_model}" ] || return 1
    [ -n "${_raw_device}" ] || return 1
    [ -n "${_raw_port}" ] || return 1

    case "${_raw_engine}" in
        vllm|tei) ;;
        *)
            echo "[bedrock-serve:${INSTANCE}] ERROR: bootstrap handoff has an unknown BEDROCK_ENGINE: ${_raw_engine}" >&2
            return 2
            ;;
    esac

    # Unlike a merely-missing key, a port that IS present but non-numeric
    # will never self-correct by waiting: fail now, do not retry.
    case "${_raw_port}" in
        *[!0-9]*)
            echo "[bedrock-serve:${INSTANCE}] ERROR: bootstrap handoff has a non-numeric BEDROCK_SERVE_PORT: ${_raw_port}" >&2
            return 2
            ;;
    esac

    BEDROCK_GROUP_ID="${_raw_group}"
    BEDROCK_ENGINE="${_raw_engine}"
    BEDROCK_MODEL_ID="${_raw_model}"
    BEDROCK_ARGS="${_raw_args}"
    BEDROCK_WEIGHTS_DEVICE="${_raw_device}"
    BEDROCK_SERVE_PORT="${_raw_port}"
    return 0
}

await_env_file() {
    _waited=0
    while :; do
        # `if try_load_env; then` (not `try_load_env; _rc=$?`) for the same
        # reason as await_weights_device below: a plain assignment-less
        # command IS a checked context under set -e too, so calling
        # try_load_env as a bare statement and letting a 1 ("not yet")
        # propagate would abort the script on the very first empty-file read
        # instead of looping. The if-condition is what set -e exempts.
        if try_load_env; then
            log "bootstrap handoff loaded (group=${BEDROCK_GROUP_ID}, engine=${BEDROCK_ENGINE}, model=${BEDROCK_MODEL_ID}, port=${BEDROCK_SERVE_PORT})"
            return 0
        else
            _rc=$?
        fi
        [ "${_rc}" -eq 2 ] && fail "bootstrap handoff at ${ENV_FILE} is malformed (see above) -- refusing to guess"
        if [ "${_waited}" -ge "${ENV_WAIT_SECS}" ]; then
            fail "no usable bootstrap handoff at ${ENV_FILE} after ${ENV_WAIT_SECS}s -- cloud-init has not delivered it"
        fi
        sleep 1
        _waited=$((_waited + 1))
    done
}

# An already-mounted weights point makes device resolution a no-op, so a
# Restart=on-failure re-run (the engine itself crashed, not the mount) does
# not try to mount the same device twice.
weights_mounted() {
    awk -v mnt="${WEIGHTS_MOUNT}" '$2 == mnt { found = 1 } END { exit !found }' "${MOUNTS_FILE}"
}

# The device backing "/", stripped to its parent disk (vda2 -> vda,
# nvme0n1p2 -> nvme0n1), so the ext4 scan below never mistakes the root disk
# for a weights volume. Read from MOUNTS_FILE rather than shelling out to
# lsblk/findmnt against a real device node, which a test harness cannot fake.
root_disk() {
    # || true: a plain assignment from a command substitution is a checked
    # command under set -e -- an awk failure here (MOUNTS_FILE unreadable,
    # never expected against the real /proc/mounts) would otherwise abort
    # this function's caller's subshell outright instead of leaving _root_src
    # empty, which the case below already handles safely.
    _root_src=$(awk '$2 == "/" { print $1; exit }' "${MOUNTS_FILE}") || true
    _name="${_root_src#/dev/}"
    case "${_name}" in
        *n[0-9]*p[0-9]*) echo "${_name}" | sed -E 's/p[0-9]+$//' ;;
        *)                echo "${_name}" | sed -E 's/[0-9]+$//' ;;
    esac
    return 0
}

# Prints the filesystem type on dev, nothing if it holds none, and returns
# non-zero when it could not find out at all: a blkid that is missing, errored
# or pointed at an absent node prints exactly what a blank disk prints, so
# only the exit status tells the two apart.
fstype_of() {
    if _out=$(blkid "$1" 2>/dev/null); then
        _rc=0
    else
        _rc=$?
    fi
    # 0 is a signature found, 2 a clean probe that found none.
    [ "${_rc}" -eq 0 ] || [ "${_rc}" -eq 2 ] || return 1
    printf '%s' "${_out}" | sed -n 's/.*[[:space:]]TYPE="\([^"]*\)".*/\1/p'
}

# weights_device_ordinal maps this member's BEDROCK_WEIGHTS_DEVICE (/dev/sdf,
# /dev/sdg, ...) to its 0-based position among the bundle's members: sdf -> 0,
# sdg -> 1, and so on, mirroring nthWeightsDevice's own 'f'+n scheme
# (handlers/bedrock/launch.go) exactly. Named-letter arithmetic, not ASCII
# math: POSIX sh has no portable char-to-int builtin, and a bundle never
# carries more than a handful of co-served members, so the alphabet is not a
# real ceiling to enumerate by hand. Prints the ordinal and returns 0, or
# returns 2 (malformed, never worth retrying) for a suffix outside f..z.
weights_device_ordinal() {
    case "${BEDROCK_WEIGHTS_DEVICE}" in
        */sdf) echo 0 ;; */sdg) echo 1 ;; */sdh) echo 2 ;; */sdi) echo 3 ;;
        */sdj) echo 4 ;; */sdk) echo 5 ;; */sdl) echo 6 ;; */sdm) echo 7 ;;
        */sdn) echo 8 ;; */sdo) echo 9 ;; */sdp) echo 10 ;; */sdq) echo 11 ;;
        */sdr) echo 12 ;; */sds) echo 13 ;; */sdt) echo 14 ;; */sdu) echo 15 ;;
        */sdv) echo 16 ;; */sdw) echo 17 ;; */sdx) echo 18 ;; */sdy) echo 19 ;;
        */sdz) echo 20 ;;
        *)
            echo "[bedrock-serve:${INSTANCE}] ERROR: BEDROCK_WEIGHTS_DEVICE '${BEDROCK_WEIGHTS_DEVICE}' is not one of the launcher's /dev/sd{f..z} names" >&2
            return 2
            ;;
    esac
    return 0
}

# The by-id link mulga-ebs-byid mints for every hot-attached Viperblock
# volume, paired with the guest device name it actually resolves to (vdb,
# vdc, ...). A bundle attaches one such volume per member, so this enumerates
# every candidate currently visible -- disambiguating which one belongs to
# THIS member is resolve_weights_device's job below, not this function's.
byid_target_pairs() {
    for _l in "${BYID_DIR}"/*Elastic_Block_Store*; do
        [ -e "${_l}" ] || continue
        _t=$(readlink -f "${_l}") || continue
        printf '%s %s\n' "$(basename "${_t}")" "${_l}"
    done
    return 0
}

# Every non-root block device carrying an ext4 filesystem -- the last-resort
# fallback tier, one candidate per attached weights volume.
ext4_candidates() {
    # || true: root_disk's own last command is a pipeline over MOUNTS_FILE,
    # and an enumerator's exit status must never leak an unrelated tool's
    # failure into the caller as if it meant something.
    _root="$(root_disk)" || true
    for _p in "${SYS_BLOCK}"/*; do
        [ -d "${_p}" ] || continue
        _name=$(basename "${_p}") || continue
        case "${_name}" in
            loop*|sr*|zram*) continue ;;
        esac
        [ "${_name}" = "${_root}" ] && continue
        _dev="${DEV_DIR}/${_name}"
        [ -e "${_dev}" ] || continue
        _fstype=$(fstype_of "${_dev}") || continue
        # Deliberately an `if`, not `[ ... ] && printf`: the latter leaves
        # this loop iteration's (and so the function's) own exit status equal
        # to the test's, so a last-processed disk that is not ext4 would make
        # the enumerator itself look like it failed to its caller.
        if [ "${_fstype}" = "ext4" ]; then
            printf '%s\n' "${_dev}"
        fi
    done
    return 0
}

# Tries the fallback chain once. Prints the device and returns 0 on a match,
# returns 1 when nothing is found yet (worth retrying -- sibling members'
# volumes may still be attaching) and 2 when this member's own handoff is
# unresolvable (never worth retrying).
#
# Single-member (bundle-of-one) and multi-member share one resolution order:
#
#   1. The device the launcher recorded, if the guest's own enumeration
#      happens to agree with it -- a virtio/nvme guest does not necessarily
#      present under that name, so this is a fast path, not the common case.
#   2. mulga-ebs-byid's by-id links, sorted by the guest device name they
#      resolve to and indexed by this member's ordinal position (sdf=0,
#      sdg=1, ...). Sound because LaunchServingVM creates AND attaches every
#      member's volume in the same deterministic Members order
#      (nthWeightsDevice(i) for volume i), and a virtio-blk guest enumerates
#      hot-attached disks in attach order -- so the Nth device by name is the
#      Nth member's volume. A bundle of one degenerates to "the sole by-id
#      link", the same fallback the single-model image always used.
#   3. The same ordinal index over the non-root ext4 disks, for a guest whose
#      by-id bridge has not minted a link yet.
resolve_weights_device() {
    if [ -e "${BEDROCK_WEIGHTS_DEVICE}" ]; then
        printf '%s\n' "${BEDROCK_WEIGHTS_DEVICE}"
        return 0
    fi

    _ordinal=$(weights_device_ordinal) || return 2

    # || true on each: awk's own END{exit !f} deliberately returns non-zero
    # when this member's ordinal has no candidate yet, but that is this
    # function's normal "not found on this pass" outcome, not a script
    # error -- an unguarded `var=$(cmd)` whose cmd fails is a checked
    # command under set -e even though the real decision is the `-n` test
    # two lines down, and dash (unlike bash) does not exempt it just because
    # the caller eventually consumes this function's result from an if.
    _byid_dev="$(byid_target_pairs | sort -k1,1 | awk -v n="$((_ordinal + 1))" 'NR==n{print $2; f=1} END{exit !f}')" || true
    if [ -n "${_byid_dev}" ]; then
        printf '%s\n' "${_byid_dev}"
        return 0
    fi

    _ext4_dev="$(ext4_candidates | sort | awk -v n="$((_ordinal + 1))" 'NR==n{print; f=1} END{exit !f}')" || true
    if [ -n "${_ext4_dev}" ]; then
        printf '%s\n' "${_ext4_dev}"
        return 0
    fi

    return 1
}

await_weights_device() {
    _waited=0
    while :; do
        # A plain `_dev=$(resolve_weights_device); _rc=$?` is NOT a checked
        # context under set -e: the assignment's own failure (resolve
        # returning 1 while the volume is still attaching, the normal case on
        # every cold start) would exit the whole script on the spot, and
        # `_rc=$?` would never run to tell the difference from "unresolvable".
        # The if/else form is the one context set -e exempts, so the "not
        # found yet, keep waiting" path actually gets to retry.
        if _dev=$(resolve_weights_device); then
            printf '%s\n' "${_dev}"
            return 0
        else
            _rc=$?
        fi
        [ "${_rc}" -eq 2 ] && fail "this member's weights device could not be resolved -- refusing to guess (see above)"
        if [ "${_waited}" -ge "${DEVICE_WAIT_SECS}" ]; then
            fail "no weights volume resolved after ${DEVICE_WAIT_SECS}s"
        fi
        sleep 1
        _waited=$((_waited + 1))
    done
}

await_env_file

command -v blkid >/dev/null 2>&1 ||
    fail "blkid is not installed in this image; the by-id and ext4-scan fallbacks cannot run without it"

if weights_mounted; then
    log "${WEIGHTS_MOUNT} is already a mount point; reusing it"
else
    _device=$(await_weights_device)
    log "weights device resolved to ${_device}"
    mkdir -p "${WEIGHTS_MOUNT}"
    # Read-only: nothing in the serving path writes weights, and a COW clone
    # that gets dirtied costs storage for no gain.
    mount -o ro "${_device}" "${WEIGHTS_MOUNT}" ||
        fail "could not mount ${_device} read-only at ${WEIGHTS_MOUNT}"
    log "weights mounted read-only at ${WEIGHTS_MOUNT} from ${_device}"
fi

case "${BEDROCK_ENGINE}" in
    vllm)
        # --served-model-name reports the Bedrock model ID via /v1/models,
        # not the mount path -- the gateway sends the Bedrock ID as the
        # OpenAI `model` field. BEDROCK_ARGS is deliberately unquoted: it is
        # a space-separated list of extra flags the operator supplied, and
        # each one must reach vllm serve as its own argument.
        # shellcheck disable=SC2086
        exec "${VLLM_VENV_BIN}/vllm" serve "${WEIGHTS_MOUNT}" \
            --port "${BEDROCK_SERVE_PORT}" \
            --served-model-name "${BEDROCK_MODEL_ID}" \
            ${BEDROCK_ARGS}
        ;;
    tei)
        # TEI's own CUDA build links against a CUDA 12.9 runtime this image
        # otherwise carries none of (same reasoning as vllm's FlashInfer
        # sampler being disabled: no toolkit at runtime) -- scoped to this
        # exec only, so it can never shadow vllm's own pip-bundled CUDA
        # libraries for a sibling member's process.
        #
        # TEI runs directly on BEDROCK_SERVE_PORT, the same shape as the vllm
        # case above -- readiness.go's waitReadyAll probes each member on the
        # route its own engine serves (vLLM's /v1/models, TEI's /health), so
        # nothing needs to sit in front of TEI translating one into the other.
        # --model-id doubles as the local weights path here: TEI's own CLI
        # accepts either a hub repo id or a local directory under that flag.
        LD_LIBRARY_PATH="${TEI_LIB_DIR}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
        export LD_LIBRARY_PATH
        # BEDROCK_ARGS deliberately unquoted, same reasoning as vllm's case
        # above: a space-separated list of extra flags, one per argv word.
        # shellcheck disable=SC2086
        exec "${TEI_BIN}" \
            --model-id "${WEIGHTS_MOUNT}" \
            --port "${BEDROCK_SERVE_PORT}" \
            ${BEDROCK_ARGS}
        ;;
    *)
        fail "unreachable: BEDROCK_ENGINE '${BEDROCK_ENGINE}' passed handoff validation but matched no exec branch"
        ;;
esac
