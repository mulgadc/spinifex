#!/sbin/openrc-run
# rds-datadir — boot oneshot that discovers the hot-plugged data volume, formats
# it if authorized, and mounts it at the datadir mount point. It runs after the
# agent has written the authenticated handoff and before anything can use the
# MariaDB datadir. Soft ordering keeps a failed boot visible on the console.

description="Spinifex RDS data volume mount"

AGENT_ENV="/etc/spinifex-rds/agent.env"

depend() {
    after localmount rds-agent
    before rds-init mariadb
}

start_pre() {
    # This image's layout, stated here because the mount script is shared by
    # every engine preset. A delivered RDS_DATA_MOUNT still wins, so the control
    # plane can move the mount point without rebuilding the image.
    RDS_DATA_MOUNT="/var/lib/mysql"
    RDS_ENGINE_USER="mysql"
    if [ -f "${AGENT_ENV}" ]; then
        # shellcheck disable=SC1090
        . "${AGENT_ENV}"
    fi
    export RDS_HANDOFF_DIR RDS_DATA_MOUNT RDS_ENGINE_USER
}

start() {
    ebegin "Mounting the RDS data volume"
    # To the console for the same reason rds-init's is: the serial log is the
    # only view of a boot that failed before the engine came up.
    /usr/local/sbin/rds-datadir > /dev/console 2>&1
    eend $?
}
