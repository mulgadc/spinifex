# /etc/conf.d/postgresql — Spinifex RDS overrides for the stock Alpine
# postgresql service. Replaces the package's copy at image build time.

# PostgreSQL 18 is pinned for v1, so the version is stated here rather than
# resolved through `pg_versions get-default` at every boot.
pg_version=18

# /var/lib/postgresql is the data volume's mount point, so everything that must
# survive a VM replace — the datadir, pg_wal, the parameter include — sits there
# rather than on the disposable boot volume.
data_dir="/var/lib/postgresql/18/data"

# Config lives in the datadir for the same reason: on the boot volume a class
# change or auto-recovery would silently revert to engine defaults while the API
# still reported the customer's parameter values.
conf_dir="/var/lib/postgresql/18/data"

# Never initdb from the service. An empty datadir means the data volume did not
# attach, and auto-setup would answer that by creating an empty cluster on
# whatever is mounted there. Failing to start is the correct, visible outcome.
auto_setup="no"

logfile="/var/log/postgresql/postmaster.log"
