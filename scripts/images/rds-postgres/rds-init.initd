#!/sbin/openrc-run
# rds-init — boot oneshot that bootstraps or attaches the PostgreSQL cluster
# before the engine starts: initdb on a fresh data volume, master password,
# initial database, resolved parameters and the serving cert.
#
# Ordered `before postgresql` rather than made a dependency of it: the engine
# runs with auto_setup="no", so a failure here leaves postgresql refusing to
# start rather than silently creating an empty cluster.
#
# `after rds-agent`, not `need`: the agent does not return from its own start
# until the handoff is on disk, and a failed fetch should leave this oneshot
# failing visibly on the missing handoff rather than being skipped.

description="Spinifex RDS PostgreSQL bootstrap"

depend() {
    need net
    after rds-agent
    before postgresql
}

start() {
    ebegin "Bootstrapping the RDS PostgreSQL instance"
    # Output goes to the console: the VM has no operator login, so the host-side
    # serial log is the only view of a bootstrap that failed before the engine
    # came up.
    /usr/local/sbin/rds-init > /dev/console 2>&1
    eend $?
}
